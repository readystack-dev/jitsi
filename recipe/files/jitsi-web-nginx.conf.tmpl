# ReadyStack jitsi-meet web frontend (non-root). Rendered to /run/jitsi-web/nginx.conf at start.
# Modelled on docker-jitsi-meet's web/rootfs/defaults/meet.conf (stable-11248).
worker_processes auto;
pid /run/jitsi-web/nginx.pid;
error_log stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    tcp_nopush on;
    server_tokens off;
    client_body_temp_path /run/jitsi-web/tmp/client_body;
    proxy_temp_path /run/jitsi-web/tmp/proxy;
    fastcgi_temp_path /run/jitsi-web/tmp/fastcgi;
    uwsgi_temp_path /run/jitsi-web/tmp/uwsgi;
    scgi_temp_path /run/jitsi-web/tmp/scgi;
    resolver @RESOLVER@ valid=30s ipv6=off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen @HTTP_PORT@ default_server;
        server_name _;
        charset utf8;
        client_max_body_size 0;
        root /usr/share/jitsi-meet;

        # SSI: index.html includes config.js, and config.js reads subdir/subdomain
        ssi on;
        ssi_types application/x-javascript application/javascript;

        index index.html;
        error_page 404 /static/404.html;

        add_header X-Content-Type-Options nosniff;
        add_header Permissions-Policy "interest-cohort=()";

        set $prefix "";
        set $subdomain "";
        set $subdir "";
        set $xmpp_upstream "@XMPP_BOSH_URL_BASE@";

        location = /config.js {
            alias /run/jitsi-web/config.js;
        }

        location = /external_api.js {
            alias /usr/share/jitsi-meet/libs/external_api.min.js;
        }

        location ~ ^/(libs|css|static|images|fonts|lang|sounds|connection_optimization|.well-known)/(.*)$ {
            add_header 'Access-Control-Allow-Origin' '*';
            alias /usr/share/jitsi-meet/$1/$2;
            if ($arg_v) {
                expires 1y;
            }
        }

        # BOSH -> prosody
        location = /http-bind {
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Host @XMPP_DOMAIN@;
            proxy_pass $xmpp_upstream/http-bind?prefix=$prefix&$args;
        }

        # XMPP over websocket -> prosody
        location = /xmpp-websocket {
            tcp_nodelay on;
            proxy_http_version 1.1;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Host @XMPP_DOMAIN@;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_read_timeout 900s;
            proxy_pass $xmpp_upstream/xmpp-websocket?prefix=$prefix&$args;
        }

        # a single path segment that is not a file is a room name: serve the app
        location ~ ^/([^/?&:'"]+)$ {
            try_files $uri @root_path;
        }

        location @root_path {
            rewrite ^/(.*)$ / break;
        }
    }
}
